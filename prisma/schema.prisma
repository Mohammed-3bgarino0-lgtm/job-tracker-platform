// Qaddem AI database schema.
// Rule: unknown values are nullable. No application data is fabricated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GenderTarget {
  FEMALE
  MALE
  BOTH
}

enum ApplicationStatus {
  SUGGESTED
  SAVED
  READY
  NEEDS_REVIEW
  APPLIED
  UNDER_REVIEW
  TEST
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum ContactType {
  EMAIL
  WHATSAPP
  PHONE
  GOOGLE_FORM
  APPLICATION_LINK
  EASY_APPLY
  MANUAL_REVIEW
}

model User {
  id              String           @id @default(cuid())
  email           String           @unique
  name            String?
  phone           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profile         UserProfile?
  careerProfile   CareerProfile?
  resumes         Resume[]
  applications    Application[]
  approvedAnswers ApprovedAnswer[]
  devices         BrowserDevice[]
  auditLogs       AuditLog[]
  consentLogs     ConsentLog[]
  emailAccounts   EmailAccount[]
}

model UserProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String?
  lastName     String?
  englishName  String?
  contactEmail String?
  nationalId   String?
  nationality  String?
  gender       String?
  phone        String?
  city         String?
  country      String?
  address      String?
  linkedinUrl  String?
  githubUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CareerProfile {
  id                   String          @id @default(cuid())
  userId               String          @unique
  user                 User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline             String?
  summary              String?
  targetTitle          String?
  totalYearsExperience Int?
  experiences          Experience[]
  educations           Education[]
  skills               Skill[]
  certs                Certification[]
  languages            Language[]
  preferences          JobPreference?
  jobMatches           JobMatch[]
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model Resume {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName    String
  fileUrl     String?
  storageKey  String?
  fileSize    Int
  mimeType    String
  isPrimary   Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  extractions ResumeExtraction[]
  versions    ResumeVersion[]

  @@index([userId, createdAt])
}

model ResumeVersion {
  id          String   @id @default(cuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  versionNum  Int
  changesText String?
  createdAt   DateTime @default(now())

  @@unique([resumeId, versionNum])
}

model ResumeExtraction {
  id               String   @id @default(cuid())
  resumeId         String
  resume           Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  parsedData       Json
  confidenceScore  Float
  isReviewed       Boolean  @default(false)
  reviewedAt       DateTime?
  reviewedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([resumeId, createdAt])
}

model Experience {
  id              String        @id @default(cuid())
  careerProfileId String
  careerProfile   CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  company         String?
  role            String?
  city            String?
  startDate       DateTime?
  endDate         DateTime?
  isCurrent       Boolean       @default(false)
  description     String?
}

model Education {
  id              String        @id @default(cuid())
  careerProfileId String
  careerProfile   CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  institution     String?
  degree          String?
  fieldOfStudy    String?
  gpa             String?
  graduationYear  Int?
}

model Skill {
  id              String        @id @default(cuid())
  careerProfileId String
  careerProfile   CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  name            String
  category        String?
  level           String?

  @@unique([careerProfileId, name])
}

model Certification {
  id              String        @id @default(cuid())
  careerProfileId String
  careerProfile   CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  name            String
  issuer          String?
  issueDate       DateTime?
}

model Language {
  id              String        @id @default(cuid())
  careerProfileId String
  careerProfile   CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  name            String
  proficiency     String?
}

model JobPreference {
  id              String        @id @default(cuid())
  careerProfileId String        @unique
  careerProfile   CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  expectedSalary  Int?
  desiredCity     String?
  workType        String?
}

model JobSource {
  id     String @id @default(cuid())
  name   String
  domain String @unique
  jobs   Job[]
}

model Job {
  id                 String          @id @default(cuid())
  sourceId           String?
  source             JobSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  title              String
  company            String?
  city               String?
  description        String?
  originalUrl        String          @unique
  genderTarget       GenderTarget?
  genderConfidence   Float?
  genderEvidence     String[]        @default([])
  genderClassifiedAt DateTime?
  createdAt          DateTime        @default(now())
  contacts           JobContact[]
  matches            JobMatch[]
  applications       Application[]
}

model JobContact {
  id          String      @id @default(cuid())
  jobId       String
  job         Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  type        ContactType
  value       String
  instruction String?

  @@unique([jobId, type, value])
}

model JobMatch {
  id              String        @id @default(cuid())
  jobId           String
  job             Job           @relation(fields: [jobId], references: [id], onDelete: Cascade)
  careerProfileId String
  careerProfile   CareerProfile @relation(fields: [careerProfileId], references: [id], onDelete: Cascade)
  matchScore      Float
  matchedSkills   String[]
  missingSkills   String[]

  @@unique([jobId, careerProfileId])
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  status      ApplicationStatus @default(SUGGESTED)
  appliedAt   DateTime?
  notes       String?
  events      ApplicationEvent[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([userId, jobId])
}

model ApplicationEvent {
  id            String            @id @default(cuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        ApplicationStatus
  note          String?
  createdAt     DateTime          @default(now())
}

model ApprovedAnswer {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  question String
  answer   String

  @@unique([userId, question])
}

model EmailAccount {
  id       String          @id @default(cuid())
  userId   String
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  email    String
  provider String
  outbound OutboundEmail[]

  @@unique([userId, email, provider])
}

model OutboundEmail {
  id             String       @id @default(cuid())
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  recipientEmail String
  subject        String
  bodyHtml       String
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
}

model BrowserDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName String
  lastSyncAt DateTime @default(now())
}

model ConsentLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  consentType String
  granted     Boolean
  details     Json?
  createdAt   DateTime @default(now())

  @@index([userId, consentType, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([userId, action, createdAt])
}
