# Qaddem AI environment template. Never commit real secrets.

# Required only when persistence is enabled.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Public URL for the active environment.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Disable telemetry in CI and controlled deployments.
NEXT_TELEMETRY_DISABLED="1"

# Optional: enables Gemini-assisted job analysis and cover letters.
# Without it, the system returns deterministic confirmed fields only.
GEMINI_API_KEY="your_gemini_api_key_here"

# Reserved for the authentication phase; do not configure until auth is added.
# NEXTAUTH_SECRET="replace_with_a_long_random_secret"
# NEXTAUTH_URL="http://localhost:3000"
