# Environment Configurations for Qaddem AI (No Secrets)

# App Settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="قدّم | Qaddem AI"

# Database Connections
DATABASE_URL="postgresql://qaddem_user:qaddem_password@localhost:5432/qaddem_db?schema=public"

# Auth System Secrets
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Encrypted S3 Compatible Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=qaddem-resumes
S3_ACCESS_KEY=minio_access_key
S3_SECRET_KEY=minio_secret_key
S3_REGION=us-east-1

# Email Connectors (OAuth & SMTP)
GMAIL_CLIENT_ID=your_gmail_client_id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your_gmail_client_secret
OUTLOOK_CLIENT_ID=your_outlook_client_id
OUTLOOK_CLIENT_SECRET=your_outlook_client_secret

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=smtp_username
SMTP_PASS=smtp_password
SMTP_FROM_EMAIL=no-reply@qaddem.ai

# Redis Worker Queue (Background Jobs)
REDIS_URL="redis://localhost:6379"

# Anti-Spam Security Settings
MAX_DAILY_EMAILS_PER_USER=50
REQUIRE_USER_CONFIRMATION_BEFORE_SENDING=true
