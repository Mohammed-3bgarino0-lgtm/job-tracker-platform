{
  "manifest_version": 3,
  "name": "قدّم | Qaddem AI - المحلل العام لمصادر الوظائف وتعبئة الطلبات",
  "version": "1.2.0",
  "description": "إضافة قدّم | Qaddem AI المجهزة بالمحلل العام لمصادر الوظائف لتحليل أي رابط أو منشور واستخراج الإيميلات والأرقام وتوليد مسودات EML وتعبئة الاستمارات بموافقتك الصريحة دون تجاوز CAPTCHA أو OTP أو نفاذ.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "css": ["styles.css"],
      "js": ["adapters/generic-adapter.js", "adapters/universal-adapter.js", "content.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "فتح قدّم | Qaddem AI"
  },
  "options_page": "options/options.html"
}
