{
  "manifest_version": 3,
  "name": "قدّم | Qaddem AI - مساعد التوظيف وتعبئة طلبات العمل",
  "version": "1.0.0",
  "description": "إضافة قدّم | Qaddem AI لمساعدة الباحثين عن عمل على حفظ الوظائف، استخراج البيانات، وتعبئة الاستمارات بموافقتك الصريحة دون تجاوز CAPTCHA أو OTP أو نفاذ.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "css": ["styles.css"],
      "js": ["adapters/generic-adapter.js", "content.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "فتح قدّم | Qaddem AI"
  },
  "options_page": "options/options.html"
}
