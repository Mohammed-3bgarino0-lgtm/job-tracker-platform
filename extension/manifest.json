{
  "manifest_version": 3,
  "name": "قدّم | Qaddem AI - محول وظائف @Wdhifaa وتعبئة الطلبات",
  "version": "1.1.0",
  "description": "إضافة قدّم | Qaddem AI المجهزة بمحول وظائف @Wdhifaa لسحب وتصنيف الفرص على X وتوليد مسودات EML وتعبئة استمارات التوظيف بموافقتك الصريحة دون تجاوز CAPTCHA أو OTP أو نفاذ.",
  "permissions": [
    "activeTab",
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "https://x.com/*", "https://twitter.com/*"],
      "css": ["styles.css"],
      "js": ["adapters/generic-adapter.js", "adapters/wdhifaa-adapter.js", "content.js"]
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "فتح قدّم | Qaddem AI"
  },
  "options_page": "options/options.html"
}
