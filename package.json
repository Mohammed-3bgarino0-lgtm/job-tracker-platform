{
  "name": "qaddem-ai-monorepo",
  "version": "1.5.0",
  "private": true,
  "description": "منصة قدّم | Qaddem AI - المساعد الذكي للبحث عن الوظائف وتعبئة الطلبات",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --filter @qaddem/web dev",
    "build": "pnpm db:generate && pnpm --filter @qaddem/web build",
    "typecheck": "pnpm --filter @qaddem/shared typecheck && pnpm --filter @qaddem/web typecheck",
    "test": "pnpm --filter @qaddem/shared test && pnpm --filter @qaddem/web test",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "db:push": "prisma db push --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "typescript": "^5.8.3"
  }
}
